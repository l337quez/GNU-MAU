# Configuración del servidor
DEBUG=true
DB_NAME=projects_db

# Motor de Base de Datos a usar: 'mongita' o 'mongodb'
DB_ENGINE=mongita

# Si se usa 'mongodb' (tradicional / producción)
MONGODB_URI=mongodb://localhost:27017

# Si se usa 'mongita' (embebida local / desarrollo)
# MONGITA_DB_DIR=../desktop/app/mongita_data

# Configuracion de Notas (Boveda Local / Obsidian)
LOCAL_VAULT_ENABLED=false
LOCAL_VAULT_PATH=C:/Users/tu_usuario/Documents/MiObsidianVault

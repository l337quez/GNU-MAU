# Copy this file to .env and adjust the values for your machine.
# docker-compose.yml reads these variables automatically.

# X11 display used by the GUI inside the container
DISPLAY=:0
QT_QPA_PLATFORM=xcb

# Persistent host directories (config.json, storage and mongita_data).
# Defaults are ./.docker-data/config and ./.docker-data/data.
# To reuse an existing installation/data directory:
#GNU_MAU_CONFIG_PATH=/mnt/ronal_disk/contenedores/gnu_mau_data/config
#GNU_MAU_DATA_PATH=/mnt/ronal_disk/contenedores/gnu_mau_data
